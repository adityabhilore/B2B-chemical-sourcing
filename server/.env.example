# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chemical_market_db"

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────
# JWT
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_ME_WITH_64_BYTE_HEX
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_64_BYTE_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
# Optional HTTPS webhook for sanitized JSON operational alerts (database, email, and uploads)
OPS_ALERT_WEBHOOK=

# ─────────────────────────────────────────────
# CLOUDINARY
# Get from https://cloudinary.com/console
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_API_KEY=REPLACE_ME
CLOUDINARY_API_SECRET=REPLACE_ME

# ─────────────────────────────────────────────
# EMAIL (Nodemailer SMTP)
# Gmail: use an App Password (not account password)
# App Password: https://myaccount.google.com/apppasswords
# ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_ME@gmail.com
SMTP_PASS=REPLACE_ME_APP_PASSWORD
EMAIL_FROM="Chemical Market <REPLACE_ME@gmail.com>"

# ─────────────────────────────────────────────
# ADMIN SEED (only used during: npm run seed)
# ─────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@chemicalmarket.com
SEED_ADMIN_PASSWORD=ChangeMe_Strong_Password_123!
SEED_ADMIN_NAME=System Admin
